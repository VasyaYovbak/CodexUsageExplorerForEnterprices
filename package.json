{
  "name": "codex-token-usage-for-enterprises",
  "displayName": "Codex Token Usage For Enterprises",
  "description": "A local dashboard for Codex token usage from session transcripts.",
  "version": "0.1.2",
  "publisher": "DarkStyle",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VasyaYovbak/CodexUsageExplorerForEnterprices.git"
  },
  "scripts": {
    "test": "node test/usage.test.js && node test/pricing.test.js"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:codexUsage.dashboard",
    "onCommand:codexUsage.refresh",
    "onCommand:codexUsage.openSettings"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexUsage.refresh",
        "title": "Codex Usage: Refresh"
      },
      {
        "command": "codexUsage.openSettings",
        "title": "Codex Usage: Configure Codex Home"
      }
    ],
    "configuration": {
      "title": "Codex Usage",
      "properties": {
        "codexUsage.codexHome": {
          "type": "string",
          "default": "~/.codex",
          "description": "Additional Codex data directory containing sessions and archived_sessions; configured and available default directories are combined automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexUsage",
          "title": "Codex Usage",
          "icon": "media/codex.svg"
        }
      ]
    },
    "views": {
      "codexUsage": [
        {
          "id": "codexUsage.dashboard",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    }
  }
}
